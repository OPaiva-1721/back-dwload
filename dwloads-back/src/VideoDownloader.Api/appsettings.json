{
  "YtDlp": {
    "ExecutablePath": "yt-dlp",
    "CookiesFile": "/app/cookies.txt"
  },
  "Storage": {
    "BasePath": "downloads",
    "BaseUrl": "http://localhost:5089",
    "FileRetention": "01:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  }
}
